# Supabase + Prisma
# Get these from: Supabase Dashboard → Project Settings → Database
#
# DATABASE_URL: Use "Connection string" → "URI" (Transaction pooler recommended for Next.js)
#   Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#   Or direct: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Optional (for Supabase client / RLS later):
#   NEXT_PUBLIC_SUPABASE_URL = https://[PROJECT-REF].supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = your-anon-key
#
# Vendors REST table (PostgREST). Snake_case Postgres example:
#   NEXT_PUBLIC_SUPABASE_VENDORS_TABLE=carry_class_vendor_data
# Legacy sheet-style name (spaces OK): "CarryClass Vendor Data" — also the code default if unset.
#
# Required when the table name does NOT contain "CarryClass" (see isCarryClassVendorShape in vendors-db):
#   NEXT_PUBLIC_SUPABASE_VENDORS_SHAPE=carryclass
# Alternative shapes: legacy | prisma | vendor
#
# Optional: server-side vendor reads bypass RLS (Dashboard → Settings → API → service_role).
# Do NOT expose this to the browser; keep it server-only (e.g. only read in vendors-db).
#   SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vendor listing writes MUST use DATABASE_URL (Prisma/psql), not only NEXT_PUBLIC_SUPABASE_URL.
# Production reads vendors from DATABASE_URL when REST and Postgres project refs differ.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Onboarding profile schema (the `vendors` table read over REST via supabaseAdmin()).
# ONLY needed when NEXT_PUBLIC_SUPABASE_URL and DATABASE_URL are different projects.
# Point this at the NEXT_PUBLIC_SUPABASE_URL project's Postgres so
# `npm run migrate:sql -- --file migrations/onboarding.sql --target onboarding` lands
# on the project the app actually reads. Not used at runtime — migrations only.
# ONBOARDING_DATABASE_URL="postgresql://postgres.[REST-PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# NOTE: the Prisma CLI reads `.env` ONLY — never `.env.local`. Keep real secrets in
# `.env.local` and run migrations via `npm run migrate:sql` (it resolves env the way
# Next.js does and prints the target project before writing). A stale or placeholder
# DATABASE_URL in `.env` will otherwise silently retarget migrations.

# Local dev: read vendor listings from DATABASE_URL (same DB as production vendor data)
# VENDORS_FETCH_VIA_DATABASE=1

# Clerk — required in production (Dashboard → API Keys)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...
# Optional: customize sign-in/up URLs
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
#
# Clerk auth emails (sign-up / sign-in verification codes):
# By default Clerk sends these using the Application name in the Clerk Dashboard.
# If it still shows an old name (e.g. "CCW Courses"), run:
#   npm run configure:clerk-branding
# For CarryClass-branded delivery via Resend instead, set up the webhook (see script output):
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# CLERK_AUTH_EMAIL_FROM=CarryClass <notifications@getcarryclass.com>

# App URL (used by Stripe Checkout redirects, and to derive the Stripe Connect
# OAuth redirect URI). `npm run dev` serves on 3001, so a value of 3000 here
# produces a redirect URI that will not match the one registered with Stripe.
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# Claim verification (instructor listing ownership)
# Email codes via Resend (also used by dashboard test emails)
# RESEND_API_KEY=re_...
# Optional pepper for hashing claim codes (falls back to CRON_SECRET / CLERK_SECRET_KEY)
# Generate: openssl rand -base64 32
# Set in .env.local and Vercel production — do not commit the value.
# CLAIM_CODE_PEPPER=long-random-string
# Log codes to server console in non-dev (never expose to clients)
# CLAIM_DEV_LOG_CODES=1
#
# Phone codes via Twilio SMS — required for "verify by phone"
# TWILIO_ACCOUNT_SID=AC...   (from Twilio Console → Account Info)
# TWILIO_AUTH_TOKEN=...      (same; replace placeholder when app is approved)
# TWILIO_FROM_NUMBER=+12134153627   (E.164 — your Twilio number)
# Pre-flight (npm run check:instructor-funnel) needs all three set; placeholders
# pass the check but SMS send fails until real SID/token are configured.

# Google Analytics 4 (loaded in production only)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-T2T75KLYGL

# Stripe — booking / Checkout (test keys from Stripe Dashboard)
# STRIPE_SECRET_KEY and STRIPE_CLIENT_ID are REQUIRED for the instructor funnel:
# onboarding step 5 refuses to advance until Connect OAuth sets stripe_account_id,
# so without them nobody reaches step 6, publish, or /dashboard/vendor.
# Verify with: npm run check:stripe-connect
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (booking payments only; not needed for step 5)
# STRIPE_CLIENT_ID=ca_...  (Connect → OAuth client id, test mode for local dev)
# Add redirect URI in Stripe Dashboard → Connect → Settings → Onboarding options → OAuth:
#   http://localhost:3001/api/stripe-connect/callback
# Defaults to NEXT_PUBLIC_APP_URL + /api/stripe-connect/callback; pin it explicitly with:
# STRIPE_CONNECT_REDIRECT_URI=https://your-domain.com/api/stripe-connect/callback
# Must be sk_test_/sk_live_ — restricted keys (rk_) do not work for Connect OAuth.

# Google Places (Place Details API) for vendor listing Google reviews
# Server-only key. Enable Places API and keep unrestricted by client origin.
# GOOGLE_PLACES_API_KEY=AIza...

# Optional: demo vendor Connect account for prisma seed (`npm run db:seed`)
# Must be a test Connect account id (acct_...) from Stripe Dashboard → Connect
# DEMO_VENDOR_STRIPE_CONNECT_ACCOUNT_ID=acct_...

# Publish → live sync allowlist (comma-separated claimed slugs).
# Non-empty: only these slugs get listing UPDATE + Prisma Vendor/ClassSession sync
# on publish. Other publishes still set onboarding is_published, but skip live sync.
# Empty/unset: full go-live (every publish syncs). Keep out of committed .env —
# set in .env.local / Vercel only while testing.
#
# Claim-funnel smoke-test listing (search INTERNAL / Claim Funnel on /instructors/claim):
#   PUBLISH_LIVE_SLUG_ALLOWLIST=internal-claim-funnel-test-6b7e67a50b
# That value is the merged canonical slug for "INTERNAL — Claim Funnel Test"
# (matthiasseager@gmail.com, Alpine). Confirm in claim search results if it drifts.
# Full go-live: clear PUBLISH_LIVE_SLUG_ALLOWLIST (or leave unset).
# PUBLISH_LIVE_SLUG_ALLOWLIST=internal-claim-funnel-test-6b7e67a50b
