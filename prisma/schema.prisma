// Prisma schema for CCW Directory
// Database: PostgreSQL (Supabase)
// https://supabase.com/docs/guides/database/connecting-to-postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vendor {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  type           String   // "instructor" | "company"
  city           String
  county         String
  state          String
  countiesServed String[] // County slugs
  classTypes     String[] // "initial" | "renewal" | "both"
  formats        String[] // "in-person" | "online" | "hybrid"
  priceMin       Int?
  priceMax       Int?
  priceInitial   Int?
  priceRenewal   Int?
  priceAddGun    Int?
  address        String?
  discountInfo   String?
  website        String?
  phone          String?
  email          String?
  description    String?
  imageUrl       String?
  photos         String[] // Gallery URLs
  googleReviewsUrl String?
  googlePlaceId  String?
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())

  /** When true, vendor profile shows Book Now and /instructors/[slug]/book is enabled */
  acceptsBookings Boolean @default(false)
  /** Stripe Connect account id (acct_...) — required to run Checkout with application fee */
  stripeConnectAccountId String?

  classSessions ClassSession[]
  bookings      Booking[]
  reviews       VendorReview[]
  savedByUsers  SavedVendor[]

  @@index([county])
  @@index([slug])
  @@index([featured])
}

model SavedVendor {
  id        String   @id @default(cuid())
  userId    String
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, vendorId])
  @@index([userId, createdAt])
  @@index([vendorId])
}

enum VendorReviewStatus {
  PENDING
  APPROVED
}

model VendorReview {
  id         String             @id @default(cuid())
  vendorId   String
  vendor     Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rating     Int
  authorName String
  body       String
  status     VendorReviewStatus @default(PENDING)
  createdAt  DateTime           @default(now())

  @@index([vendorId])
  @@index([vendorId, status, createdAt])
}

model ClassSession {
  id         String   @id @default(cuid())
  vendorId   String
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime?
  title      String?
  classType  String // "initial" | "renewal"
  priceCents Int // Class tuition portion (USD cents)
  capacity   Int      @default(12)
  enrolled   Int      @default(0)
  timezone   String   @default("America/Los_Angeles")
  createdAt  DateTime @default(now())

  bookings Booking[]

  @@index([vendorId, startsAt])
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum CcwTimelineProcess {
  INITIAL
  RENEWAL
  MODIFICATION
}

enum CcwTimelineStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CcwTimelineSource {
  DOCX_IMPORT
  USER_FORM
  MANUAL
}

/// Self-reported CCW application timelines (initial / renewal / modification).
/// Mirrors VendorReview moderation pattern: rows are PENDING until approved.
model CcwTimelineSubmission {
  id              String              @id @default(cuid())
  countySlug      String              // canonical slug, e.g. "los-angeles"
  process         CcwTimelineProcess
  status          CcwTimelineStatus   @default(PENDING)
  displayName     String              @default("Anonymous")
  body            String
  dateStarted     DateTime?
  dateFinished    DateTime?
  /// Required for any APPROVED row used in metrics. Computed server-side.
  durationDays    Int?
  totalCostCents  Int?
  sourceType      CcwTimelineSource   @default(USER_FORM)
  /// Stable identifier for re-import dedup (e.g. hash of original docx segment).
  sourceRef       String?             @unique
  rawText         String?
  parseConfidence Float?
  parseWarnings   String[]
  submittedAt     DateTime            @default(now())
  reviewedAt      DateTime?

  @@index([countySlug])
  @@index([countySlug, process, status])
  @@index([status, submittedAt])
}

enum OutreachStage {
  not_contacted
  called
  emailed
  follow_up
  replied
  interested
  not_interested
  claimed
  do_not_contact
}

enum OutreachActivityType {
  note
  stage_change
  email
  call
}

enum OutreachCallDisposition {
  no_answer
  voicemail
  connected
  bad_number
}

/// One instructor business for internal outreach, deduped from per-county
/// `carry_class_vendor_data` rows. Derived fields are refreshed on sync; stage,
/// next action, and activity are only ever changed by the person working the list.
model OutreachContact {
  id                String        @id @default(cuid())
  dedupeKey         String        @unique
  displayName       String
  instructorNames   String[]
  emails            String[]
  phones            String[]
  website           String?
  addresses         String[]
  city              String?
  counties          String[]
  primaryCounty     String?
  bookingCapability String?
  directorySlug     String?
  sourceListingIds  String[]
  tags              String[]
  stage             OutreachStage @default(not_contacted)
  nextActionAt      DateTime?
  lastContactedAt   DateTime?
  doNotContact      Boolean       @default(false)
  syncedAt          DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  activities OutreachActivity[]

  @@index([stage])
  @@index([nextActionAt])
}

model OutreachActivity {
  id              String                   @id @default(cuid())
  contactId       String
  contact         OutreachContact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type            OutreachActivityType
  body            String?
  occurredAt      DateTime                 @default(now())
  fromStage       OutreachStage?
  toStage         OutreachStage?
  disposition     OutreachCallDisposition?
  durationSeconds Int?
  phone           String?
  zohoMessageId   String?
  twilioCallSid   String?
  createdAt       DateTime                 @default(now())

  @@index([contactId, occurredAt])
}

model Booking {
  id        String @id @default(cuid())
  vendorId  String
  vendor    Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  classSessionId String
  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?
  /// Human-friendly booking number shown to students and instructors (e.g. CC-7K2M9Q).
  confirmationCode        String? @unique

  customerEmail String
  customerName  String
  customerPhone String?
  clerkUserId   String?

  classAmountCents   Int
  serviceFeeCents    Int @default(700)
  /** Instructor pass-through fees captured when checkout was created. */
  passThroughFees    Json?
  passThroughCents   Int @default(0)
  totalAmountCents   Int

  status BookingStatus @default(PENDING)
  paidAt DateTime?

  createdAt DateTime @default(now())

  @@index([vendorId])
  @@index([classSessionId])
  @@index([status])
}

/// Fees quoted for a Checkout Session, copied onto Booking when payment completes.
model CheckoutFeeSnapshot {
  id                String   @id @default(cuid())
  classSessionId    String
  classAmountCents  Int
  serviceFeeCents   Int
  passThroughFees   Json
  createdAt         DateTime @default(now())
}
